<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>AEREO Test Dataset - With CRS</name>

    <Placemark>
      <name>Test Polygon</name>
      <description>Polygon feature for area measurement</description>
      <Polygon>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>
              73.8567,18.5204,0
              73.8667,18.5204,0
              73.8667,18.5304,0
              73.8567,18.5304,0
              73.8567,18.5204,0
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>

    <Placemark>
      <name>Test Line</name>
      <description>LineString feature for length measurement</description>
      <LineString>
        <coordinates>
          73.8567,18.5204,0
          73.8667,18.5304,0
        </coordinates>
      </LineString>
    </Placemark>

    <Placemark>
      <name>Test Point</name>
      <description>Point feature with no measurement</description>
      <Point>
        <coordinates>73.8567,18.5204,0</coordinates>
      </Point>
    </Placemark>
  </Document>
</kml>
